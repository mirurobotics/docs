{
  "name": "miru-docs",
  "private": true,
  "packageManager": "pnpm@10.17.0",
  "scripts": {
    "dev": "cd docs && mint dev",
    "lint": "./scripts/lint.sh",
    "validate": "cd docs && mint validate",
    "test:lint": "./tests/test-lint.sh"
  },
  "devDependencies": {
    "cspell": "10.4.1",
    "eslint": "10.14.0",
    "eslint-plugin-mdx": "3.9.1",
    "mint": "4.3.5"
  },
  "pnpm": {
    "overrides": {
      "flatted": ">=3.4.2",
      "glob": ">=14.0.2",
      "js-yaml": ">=4.3.1 <5",
      "minimatch": ">=11.0.1",
      "picomatch": ">=4.0.4",
      "smol-toml": ">=1.6.1",
      "yaml": ">=2.8.3",
      "brace-expansion": ">=5.0.9",
      "sharp": ">=0.35.5"
    }
