{
  "name": "pwsh",
  "scopeName": "source.pwsh",
  "patterns": [{ "include": "#miru-command" }, { "include": "source.powershell" }],
  "repository": {
    "miru-command": {
      "comment": "Colors a miru command like the bash grammar does, so PowerShell tabs match their Unix twins. A line ending in a backtick continues the command.",
      "begin": "^\\s*(miru)(?=\\s|$)",
      "beginCaptures": { "1": { "name": "entity.name.function.call.pwsh entity.name.command.pwsh" } },
      "end": "(?<![`\\n])$",
      "patterns": [
        { "match": "(?<=\\s)--?[A-Za-z][\\w-]*", "name": "constant.other.option.pwsh" },
        { "match": "`$", "name": "constant.character.escape.line-continuation.pwsh" },
        { "match": "\\$(?:env:)?\\w+", "name": "variable.other.readwrite.pwsh" },
        { "match": "\"[^\"]*\"|'[^']*'", "name": "string.quoted.pwsh" },
        { "match": "[^\\s`\"'$]+", "name": "string.unquoted.argument.pwsh" }
      ]
    }
  }
}
