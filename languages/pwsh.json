{
  "name": "pwsh",
  "displayName": "PowerShell",
  "scopeName": "source.pwsh",
  "patterns": [
    { "include": "#comment" },
    { "include": "#command" },
    { "include": "#common" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.pwsh",
      "match": "(?:^|(?<=\\s))#.*$"
    },
    "command": {
      "begin": "(?:^|(?<=[|;{(=]))\\s*(?![#$\"'(){}\\[\\]|;`=]|(?:foreach|if|elseif|else|for|while|do|function|return|param|try|catch|finally|switch)\\b)([^\\s|;(){}]+)",
      "beginCaptures": {
        "1": { "name": "entity.name.function.call.pwsh" }
      },
      "end": "(?<![`\\n])$|(?=[|;})])",
      "patterns": [
        { "include": "#comment" },
        { "include": "#continuation" },
        { "include": "#option" },
        { "include": "#string" },
        { "include": "#variable" },
        { "include": "#argument" }
      ]
    },
    "common": {
      "patterns": [
        { "include": "#continuation" },
        { "include": "#string" },
        { "include": "#variable" },
        { "include": "#keyword" },
        { "include": "#pipe" }
      ]
    },
    "continuation": {
      "name": "constant.character.escape.line-continuation.pwsh",
      "match": "`(?=\\s*$)"
    },
    "option": {
      "name": "constant.other.option.pwsh",
      "match": "(?<=\\s)--?[A-Za-z][\\w-]*"
    },
    "argument": {
      "name": "string.unquoted.argument.pwsh",
      "match": "[^\\s\"'`|;(){}$]+"
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.pwsh",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.pwsh", "match": "`." },
            { "include": "#variable" }
          ]
        },
        {
          "name": "string.quoted.single.pwsh",
          "begin": "'",
          "end": "'"
        }
      ]
    },
    "variable": {
      "name": "variable.other.readwrite.pwsh",
      "match": "\\$(?:\\{[^}]*\\}|[A-Za-z_][\\w:]*|_)"
    },
    "keyword": {
      "name": "keyword.control.pwsh",
      "match": "\\b(?:foreach|if|elseif|else|for|while|do|function|return|param|try|catch|finally|switch|in)\\b"
    },
    "pipe": {
      "name": "keyword.operator.pipe.pwsh",
      "match": "\\|"
    }
  }
}
